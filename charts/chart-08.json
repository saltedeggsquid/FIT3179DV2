{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 400,
  "padding": {
    "left": 8,
    "right": 8,
    "top": 8,
    "bottom": 8
  },
  "data": {
    "url": "data/g12_heatmap.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum.age_group !== 'All dependent children'"
    }
  ],
  "mark": {
    "type": "rect",
    "cornerRadius": 3,
    "stroke": "#ffffff",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "parent_profile",
      "type": "ordinal",
      "sort": [
        "Both parents speak English only",
        "At least one parent uses another language",
        "English proficiency not stated"
      ],
      "title": "Parents’ English proficiency profile",
      "axis": {
        "labelAngle": 0,
        "labelLimit": 220,
        "labelFontSize": 10,
        "labelLineHeight": 12,
        "labelPadding": 8,
        "titlePadding": 18,
        "labelExpr": "datum.label === 'Both parents speak English only' ? 'Both parents speak English only' : datum.label === 'At least one parent uses another language' ? 'At least one parent uses another language' : 'English proficiency not stated'"
      }
    },
    "y": {
      "field": "age_group",
      "type": "ordinal",
      "sort": [
        "0–4 years",
        "5–9 years",
        "10–12 years",
        "13–14 years",
        "15–17 years",
        "18–20 years",
        "21–24 years",
        "All dependent children"
      ],
      "title": "Age of dependent children",
      "axis": {
        "labelFontSize": 11,
        "titlePadding": 10
      }
    },
    "color": {
      "field": "count",
      "type": "quantitative",
      "scale": {
        "scheme": "tealblues"
      },
      "legend": {
        "title": "Number of children",
        "format": ",.0f",
        "gradientLength": 400,
        "gradientThickness": 16,
        "gradientLabelLimit": 100,
        "titleFontSize": 13,
        "labelFontSize": 10,
        "offset": 10
      }
    },
    "tooltip": [
      {
        "field": "age_group",
        "title": "Children’s age"
      },
      {
        "field": "parent_profile",
        "title": "Parent profile"
      },
      {
        "field": "count",
        "type": "quantitative",
        "title": "Dependent children",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false,
      "domain": false,
      "tickSize": 0
    },
    "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "titleFontSize": 11,
      "labelFontSize": 10
    }
  }
}