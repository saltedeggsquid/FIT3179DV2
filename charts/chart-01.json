{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "data/1.1_top10_population_by_country.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum.year >= 2015 && datum.year <= 2025"
    }
  ],
  "width": "container",
  "height": 400,
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 45
    },
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {
        "format": "d",
        "tickCount": 10,
        "grid": false
      }
    },
    "y": {
      "field": "rank_by_population",
      "type": "quantitative",
      "title": "Rank",
      "scale": {
        "zero": false,
        "reverse": true
      },
      "axis": {
        "tickMinStep": 1
      }
    },
    "color": {
      "field": "country_of_birth",
      "type": "nominal",
      "title": "Country of birth",
      "scale": {
        "range": [
          "#E5E4E2",
          "#60594D",
          "#726DA8",
          "#E5E4E2",
          "#839788",
          "#E5E4E2",
          "#E5E4E2",
          "#E5E4E2",
          "#E5E4E2",
          "#E5E4E2"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "year",
        "type": "quantitative",
        "title": "Year"
      },
      {
        "field": "country_of_birth",
        "type": "nominal",
        "title": "Country of birth"
      },
      {
        "field": "rank_by_population",
        "type": "quantitative",
        "title": "Rank"
      },
      {
        "field": "estimated_resident_population",
        "type": "quantitative",
        "title": "Population",
        "format": ","
      }
    ]
  }
}