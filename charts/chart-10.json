{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 800,
  "height": 500,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "data/SA2_2021_AUST_GDA2020_simplified.geojson",
        "format": {
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f2f2f2",
        "stroke": "#b8b8b8",
        "strokeWidth": 0.25
      }
    },
    {
      "data": {
        "url": "data/g09_g43_labourforce.csv"
      },
      "transform": [
        {
          "filter": "isValid(datum.longitude) && isValid(datum.latitude) && isValid(datum.overseas_born_count) && datum.overseas_born_count > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.6,
        "stroke": "#000000",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "overseas_born_count",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [8, 500]
          },
          "legend": {
            "title": "Overseas-born residents",
            "format": ",.0f",
            "orient": "bottom-right"
          }
        },
        "color": {
          "field": "labour_force_participation_pct",
          "type": "quantitative",
          "scale": {
            "scheme": "greens"
          },
          "legend": {
            "title": "Labour-force participation (%)",
            "orient": "bottom-left",
            "format": ".0f",
            "gradientLength": 250,
            "gradientThickness": 16,
            "titleFontSize": 13,
            "labelFontSize": 10
          }
        },
        "tooltip": [
          {
            "field": "SA2_NAME21",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "overseas_born_count",
            "type": "quantitative",
            "title": "Overseas-born residents",
            "format": ",.0f"
          },
          {
            "field": "overseas_born_pct",
            "type": "quantitative",
            "title": "Overseas-born population (%)",
            "format": ".2f"
          },
          {
            "field": "total_population",
            "type": "quantitative",
            "title": "Total population",
            "format": ",.0f"
          },
          {
            "field": "labour_force_participation_pct",
            "type": "quantitative",
            "title": "Labour-force participation (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
