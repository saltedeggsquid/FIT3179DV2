{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 500,
  "height": 450,
  "projection": {
    "type": "equalEarth"
  },
  "params": [
    {
      "name": "language",
      "value": "Mandarin",
      "bind": {
        "input": "select",
        "options": [
          "Mandarin",
          "Arabic",
          "Vietnamese",
          "Cantonese",
          "Punjabi"
        ],
        "name": "Select language: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/SA2_2021_AUST_GDA2020_simplified.geojson",
        "format": {
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f2f2f2",
        "stroke": "#b8b8b8",
        "strokeWidth": 0.25
      }
    },
    {
      "data": {
        "url": "data/SA2_language_groups_with_centroids_2021.csv"
      },
      "transform": [
        {
          "calculate": "language === 'Mandarin' ? datum.mandarin_count : language === 'Arabic' ? datum.arabic_count : language === 'Vietnamese' ? datum.vietnamese_count : language === 'Cantonese' ? datum.cantonese_count : datum.punjabi_count",
          "as": "selected_count"
        },
        {
          "calculate": "language === 'Mandarin' ? datum.mandarin_pct : language === 'Arabic' ? datum.arabic_pct : language === 'Vietnamese' ? datum.vietnamese_pct : language === 'Cantonese' ? datum.cantonese_pct : datum.punjabi_pct",
          "as": "selected_pct"
        },
        {
          "filter": "isValid(datum.longitude) && isValid(datum.latitude) && datum.selected_count > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#1f5a4d",
        "size": 7,
        "opacity": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "SA2_NAME21",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "selected_count",
            "type": "quantitative",
            "title": "Speakers",
            "format": ","
          },
          {
            "field": "selected_pct",
            "type": "quantitative",
            "title": "Share of local population (%)",
            "format": ".2f"
          },
          {
            "field": "total_population",
            "type": "quantitative",
            "title": "Total population",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {"state": "WA", "longitude": 121.0, "latitude": -25.5},
          {"state": "NT", "longitude": 133.5, "latitude": -19.0},
          {"state": "SA", "longitude": 135.0, "latitude": -30.0},
          {"state": "QLD", "longitude": 146.0, "latitude": -22.0},
          {"state": "NSW", "longitude": 147.0, "latitude": -32.5},
          {"state": "VIC", "longitude": 145.5, "latitude": -36.5},
          {"state": "TAS", "longitude": 146.5, "latitude": -42.0},
          {"state": "ACT", "longitude": 149.0, "latitude": -35.5}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#222222",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "note": "● Each dot represents one SA2 area"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "color": "#555555"
      },
      "encoding": {
        "x": {"value": 20},
        "y": {"value": 30},
        "text": {"field": "note"}
      }
    }
  ]
}
