{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Cultural activity participation rates by age group, Australia, 2021–22. Source: ABS Cultural and creative activities, Table 4.",
  "width": 420,
  "height": 420,
  "padding": 40,
  "data": [
    {
      "name": "table",
      "url": "data/cultural_participation_by_age_radar.csv",
      "format": {
        "type": "csv",
        "parse": {
          "participation_rate": "number"
        }
      }
    },
    {
      "name": "series",
      "source": "table",
      "transform": [
        {
          "type": "formula",
          "expr": "indexof(['Singing or playing a musical instrument','Dancing','Writing any fiction or non-fiction','Visual art activities','Craft activities'], datum.activity)",
          "as": "axisIndex"
        },
        {
          "type": "formula",
          "expr": "2 * PI * datum.axisIndex / 5 - PI / 2",
          "as": "angle"
        },
        {
          "type": "formula",
          "expr": "datum.participation_rate / 30",
          "as": "radius"
        },
        {
          "type": "formula",
          "expr": "width / 2 + datum.radius * (width / 2 - 35) * cos(datum.angle)",
          "as": "x"
        },
        {
          "type": "formula",
          "expr": "height / 2 + datum.radius * (height / 2 - 35) * sin(datum.angle)",
          "as": "y"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "15–24 years",
        "25–34 years",
        "35–44 years",
        "45–54 years",
        "55–64 years",
        "65 years and over"
      ],
      "range": [
        "#4477AA",
        "#EE7733",
        "#228833",
        "#AA3377",
        "#66CCEE",
        "#CCBB44"
      ]
    }
  ],
  "marks": [
    {
      "type": "group",
      "from": {
        "facet": {
          "name": "ageSeries",
          "data": "series",
          "groupby": [
            "age_group"
          ]
        }
      },
      "marks": [
        {
          "type": "line",
          "from": {
            "data": "ageSeries"
          },
          "sort": {
            "field": "axisIndex"
          },
          "encode": {
            "update": {
              "x": {
                "field": "x"
              },
              "y": {
                "field": "y"
              },
              "stroke": {
                "scale": "color",
                "field": "age_group"
              },
              "strokeWidth": {
                "value": 2
              },
              "strokeOpacity": {
                "value": 0.9
              }
            }
          }
        },
        {
          "type": "symbol",
          "from": {
            "data": "ageSeries"
          },
          "encode": {
            "update": {
              "x": {
                "field": "x"
              },
              "y": {
                "field": "y"
              },
              "fill": {
                "scale": "color",
                "field": "age_group"
              },
              "size": {
                "value": 35
              },
              "tooltip": {
                "signal": "datum.age_group + ' | ' + datum.activity + ': ' + format(datum.participation_rate, '.1f') + '%' "
              }
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "from": {
        "data": "table"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width/2 + (width/2 - 10) * cos(2 * PI * indexof(['Singing or playing a musical instrument','Dancing','Writing any fiction or non-fiction','Visual art activities','Craft activities'], datum.activity) / 5 - PI/2)"
          },
          "y": {
            "signal": "height/2 + (height/2 - 10) * sin(2 * PI * indexof(['Singing or playing a musical instrument','Dancing','Writing any fiction or non-fiction','Visual art activities','Craft activities'], datum.activity) / 5 - PI/2)"
          },
          "text": {
            "field": "activity"
          },
          "fill": {
            "value": "#333"
          },
          "fontSize": {
            "value": 10
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "opacity": {
            "signal": "datum.age_group == '15–24 years' ? 1 : 0"
          }
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}